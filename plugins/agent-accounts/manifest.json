{
  "manifestVersion": 1,
  "id": "com.toolbox.agent-accounts",
  "name": "Agent 账号管理",
  "version": "1.9.9",
  "publisher": "toolbox",
  "description": "多来源 AI 编程账号管理：导入、余量查询、按来源切换、任意账号单独签到与一键批量签到。",
  "author": "Toolbox",
  "license": "MIT",
  "icon": "chart",
  "engines": {
    "toolbox": ">=0.1.1",
    "pluginApi": "^1.0.0"
  },
  "dependencies": {},
  "permissions": {
    "storage": true,
    "events": true,
    "server": {
      "enabled": true
    },
    "files": [
      "%APPDATA%\\JetBrains",
      "%LOCALAPPDATA%\\JetBrains",
      "%APPDATA%\\CodeBuddy",
      "%LOCALAPPDATA%\\CodeBuddy CN",
      "%LOCALAPPDATA%\\WorkBuddy",
      "%APPDATA%\\Cursor",
      "%APPDATA%\\Windsurf",
      "%APPDATA%\\Qoder",
      "%APPDATA%\\Code",
      "%APPDATA%\\Kiro",
      "%APPDATA%\\Antigravity IDE",
      "%APPDATA%\\Trae",
      "%APPDATA%\\Trae CN",
      "%APPDATA%\\Trae Solo",
      "%APPDATA%\\Trae CN Solo",
      "%APPDATA%\\Zed",
      "%USERPROFILE%\\.codex"
    ],
    "network": [
      "www.codebuddy.ai",
      "www.codebuddy.cn",
      "copilot.tencent.com",
      "api.github.com",
      "github.com",
      "cursor.com",
      "api2.cursor.sh",
      "*.windsurf.com",
      "*.codeium.com",
      "qoder.com",
      "openapi.qoder.sh",
      "*.kiro.dev",
      "*.amazonaws.com",
      "accounts.google.com",
      "oauth2.googleapis.com",
      "www.googleapis.com",
      "daily-cloudcode-pa.googleapis.com",
      "daily-cloudcode-pa.sandbox.googleapis.com",
      "agent.minimax.cn",
      "api.cline.bot",
      "api.workos.com",
      "phoenix-gw.alibaba.com",
      "www.accio-ai.com",
      "lobsterai-server.youdao.com",
      "xiaohuanxiong.com",
      "loomyad.xunfei.cn",
      "account.xfinfr.com",
      "open.weixin.qq.com",
      "long.open.weixin.qq.com",
      "lobsterai.youdao.com",
      "api-overmind.youdao.com",
      "*.trae.ai",
      "api.trae.ai",
      "www.trae.cn",
      "api.trae.cn",
      "*.trae.cn",
      "*.trae.com.cn",
      "*.traeapi.us",
      "*.marscode.com"
    ]
  },
  "runtime": {
    "backend": "js",
    "entry": "backend/index.js",
    "frontend": "frontend/index.js",
    "exports": ["state", "runAction"]
  },
  "contributes": {
    "sidebar": {
      "groups": [
        { "id": "agent", "label": "AI 账号", "icon": "chart", "order": 30 }
      ]
    },
    "tools": [
      {
        "type": "agent-accounts",
        "label": "Agent 账号",
        "icon": "chart",
        "multi": false,
        "description": "管理 CodeBuddy / WorkBuddy 账号，查看余量并签到",
        "group": "agent"
      }
    ]
  }
}
