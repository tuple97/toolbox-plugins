{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "paths": {
      "@toolbox/plugin-sdk": ["./packages/plugin-sdk/index.d.ts"]
    }
  },
  "include": ["packages/**/*.ts", "plugins/**/*.ts", "plugins/**/*.vue"]
}
